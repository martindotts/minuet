{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples/${input:sample}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      // Pass the shell PATH: when VS Code is opened from the Dock, the development host would
      // otherwise get the minimal macOS PATH and debug sessions cannot find `node`.
      "env": { "PATH": "${env:PATH}" },
      "preLaunchTask": "${defaultBuildTask}"
    }
  ],
  "inputs": [
    {
      "id": "sample",
      "type": "pickString",
      "description": "Sample project to open in the development window",
      "options": [
        { "label": "Checkout, TypeScript (examples/checkout)", "value": "checkout" },
        { "label": "Python (examples/sample-python)", "value": "sample-python" }
      ],
      "default": "checkout"
    }
  ]
}
