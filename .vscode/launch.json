{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples/sample-node"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      // Pass the shell PATH: when VS Code is opened from the Dock, the development host would
      // otherwise get the minimal macOS PATH and debug sessions cannot find `node`.
      "env": { "PATH": "${env:PATH}" },
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
