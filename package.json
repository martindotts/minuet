{
  "name": "minuet",
  "displayName": "minuet",
  "description": "Step-by-step debugging, explained: your AI agent turns breakpoints into a guided tour of any JavaScript/TypeScript flow, with the real values of the run.",
  "version": "0.1.0",
  "publisher": "martindotts",
  "icon": "media/icon.png",
  "author": {
    "name": "Martin Thompson"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/martindotts/minuet.git"
  },
  "homepage": "https://github.com/martindotts/minuet#readme",
  "bugs": {
    "url": "https://github.com/martindotts/minuet/issues"
  },
  "galleryBanner": {
    "color": "#46196f",
    "theme": "dark"
  },
  "keywords": [
    "debugger",
    "breakpoints",
    "annotations",
    "tour",
    "walkthrough",
    "javascript",
    "typescript",
    "vitest",
    "ai",
    "agent",
    "claude",
    "codex",
    "copilot",
    "cursor",
    "agent-skills",
    "explain"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "minuet.annotateLine",
        "title": "Annotate Breakpoint on This Line",
        "category": "minuet",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "minuet.addHighlight",
        "title": "Highlight Selection in Annotation...",
        "category": "minuet",
        "icon": "$(symbol-color)"
      },
      {
        "command": "minuet.addWatch",
        "title": "Add Expression to Evaluate...",
        "category": "minuet",
        "icon": "$(eye)"
      },
      {
        "command": "minuet.editAnnotation",
        "title": "Edit Annotation",
        "category": "minuet",
        "icon": "$(edit)"
      },
      {
        "command": "minuet.deleteAnnotation",
        "title": "Delete Annotation",
        "category": "minuet",
        "icon": "$(trash)"
      },
      {
        "command": "minuet.moveUp",
        "title": "Move Step Up",
        "category": "minuet",
        "icon": "$(arrow-up)"
      },
      {
        "command": "minuet.moveDown",
        "title": "Move Step Down",
        "category": "minuet",
        "icon": "$(arrow-down)"
      },
      {
        "command": "minuet.importTour",
        "title": "Import Tour...",
        "category": "minuet",
        "icon": "$(cloud-download)"
      },
      {
        "command": "minuet.exportTour",
        "title": "Export Tour...",
        "category": "minuet",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "minuet.saveTour",
        "title": "Save Tour",
        "category": "minuet",
        "icon": "$(save)"
      },
      {
        "command": "minuet.saveTourAs",
        "title": "Save Tour As…",
        "category": "minuet",
        "icon": "$(save-as)"
      },
      {
        "command": "minuet.closeTour",
        "title": "Close Tour",
        "category": "minuet",
        "icon": "$(close)"
      },
      {
        "command": "minuet.openSavedTour",
        "title": "Open Saved Tour",
        "category": "minuet"
      },
      {
        "command": "minuet.refreshSavedTours",
        "title": "Refresh Saved Tours",
        "category": "minuet",
        "icon": "$(refresh)"
      },
      {
        "command": "minuet.clearAll",
        "title": "Delete All Annotations",
        "category": "minuet",
        "icon": "$(clear-all)"
      },
      {
        "command": "minuet.installAgentSkill",
        "title": "Install Agent Skill",
        "category": "minuet",
        "icon": "$(sparkle)"
      },
      {
        "command": "minuet.orderByExecution",
        "title": "Order Steps by Last Run",
        "category": "minuet",
        "icon": "$(list-ordered)"
      },
      {
        "command": "minuet.openStep",
        "title": "Open Step",
        "category": "minuet"
      },
      {
        "command": "minuet.focusStep",
        "title": "Show Step",
        "category": "minuet"
      },
      {
        "command": "minuet.showContext",
        "title": "Show Tour Context",
        "category": "minuet"
      }
    ],
    "submenus": [
      {
        "id": "minuet.editorMenu",
        "label": "minuet"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "minuet.moveUp",
          "when": "false"
        },
        {
          "command": "minuet.moveDown",
          "when": "false"
        },
        {
          "command": "minuet.openStep",
          "when": "false"
        },
        {
          "command": "minuet.showContext",
          "when": "false"
        },
        {
          "command": "minuet.addHighlight",
          "when": "editorIsOpen"
        },
        {
          "command": "minuet.focusStep",
          "when": "false"
        },
        {
          "command": "minuet.openSavedTour",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "minuet.editorMenu",
          "group": "minuet@1",
          "when": "resourceScheme == file"
        }
      ],
      "minuet.editorMenu": [
        {
          "command": "minuet.annotateLine",
          "group": "1_create@1"
        },
        {
          "command": "minuet.addHighlight",
          "group": "1_create@2",
          "when": "editorHasSelection"
        },
        {
          "command": "minuet.addWatch",
          "group": "1_create@3"
        },
        {
          "command": "minuet.editAnnotation",
          "group": "2_edit@1"
        },
        {
          "command": "minuet.deleteAnnotation",
          "group": "2_edit@2"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "minuet.annotateLine",
          "group": "minuet@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "minuet.addWatch",
          "group": "minuet@2",
          "when": "resourceScheme == file"
        },
        {
          "command": "minuet.editAnnotation",
          "group": "minuet@3",
          "when": "resourceScheme == file"
        },
        {
          "command": "minuet.deleteAnnotation",
          "group": "minuet@4",
          "when": "resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "minuet.importTour",
          "group": "minuet@1",
          "when": "resourceExtname == .json"
        }
      ],
      "view/title": [
        {
          "command": "minuet.saveTour",
          "group": "navigation@1",
          "when": "view == minuet.tour && minuet.hasTour"
        },
        {
          "command": "minuet.closeTour",
          "group": "navigation@2",
          "when": "view == minuet.tour && minuet.hasTour"
        },
        {
          "command": "minuet.saveTourAs",
          "group": "2_file@1",
          "when": "view == minuet.tour && minuet.hasTour"
        },
        {
          "command": "minuet.refreshSavedTours",
          "group": "navigation@1",
          "when": "view == minuet.library"
        },
        {
          "command": "minuet.importTour",
          "group": "2_file@3",
          "when": "view == minuet.tour"
        },
        {
          "command": "minuet.exportTour",
          "group": "2_file@4",
          "when": "view == minuet.tour"
        },
        {
          "command": "minuet.orderByExecution",
          "group": "1_order@1",
          "when": "view == minuet.tour"
        },
        {
          "command": "minuet.clearAll",
          "group": "z_danger@1",
          "when": "view == minuet.tour"
        },
        {
          "command": "minuet.installAgentSkill",
          "group": "y_agents@1",
          "when": "view == minuet.tour"
        }
      ],
      "view/item/context": [
        {
          "command": "minuet.moveUp",
          "group": "inline@1",
          "when": "view == minuet.tour && viewItem == step"
        },
        {
          "command": "minuet.moveDown",
          "group": "inline@2",
          "when": "view == minuet.tour && viewItem == step"
        },
        {
          "command": "minuet.editAnnotation",
          "group": "inline@3",
          "when": "view == minuet.tour && viewItem == step"
        },
        {
          "command": "minuet.deleteAnnotation",
          "group": "inline@4",
          "when": "view == minuet.tour && viewItem == step"
        },
        {
          "command": "minuet.addWatch",
          "group": "1_edit@1",
          "when": "view == minuet.tour && viewItem == step"
        },
        {
          "command": "minuet.editAnnotation",
          "group": "1_edit@2",
          "when": "view == minuet.tour && viewItem == step"
        },
        {
          "command": "minuet.moveUp",
          "group": "2_order@1",
          "when": "view == minuet.tour && viewItem == step"
        },
        {
          "command": "minuet.moveDown",
          "group": "2_order@2",
          "when": "view == minuet.tour && viewItem == step"
        },
        {
          "command": "minuet.deleteAnnotation",
          "group": "3_delete@1",
          "when": "view == minuet.tour && viewItem == step"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "minuet",
          "title": "minuet",
          "icon": "media/tour.svg"
        }
      ]
    },
    "views": {
      "minuet": [
        {
          "id": "minuet.tour",
          "name": "Tour",
          "icon": "media/tour.svg",
          "contextualTitle": "minuet"
        },
        {
          "id": "minuet.library",
          "name": "Saved Tours",
          "icon": "media/tour.svg",
          "contextualTitle": "minuet"
        }
      ],
      "debug": [
        {
          "type": "webview",
          "id": "minuet.step",
          "name": "Current Step",
          "contextualTitle": "minuet",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "minuet.tour",
        "contents": "There are no annotations in this workspace.\n[Import Tour](command:minuet.importTour)\nYou can also annotate a breakpoint from the editor: right-click the line number → **Annotate Breakpoint on This Line**."
      },
      {
        "view": "minuet.library",
        "contents": "No saved tours yet. Saved tours go to the .minuet folder of the project (setting minuet.toursFolder), so you can share them through git.\n[Save Tour](command:minuet.saveTour)"
      }
    ],
    "colors": [
      {
        "id": "minuet.highlightBackground",
        "description": "Background of the highlighted ranges of the current step.",
        "defaults": {
          "dark": "#b180d714",
          "light": "#652d900d",
          "highContrast": "#b180d733",
          "highContrastLight": "#652d901a"
        }
      },
      {
        "id": "minuet.highlightBorder",
        "description": "Left border of the highlighted ranges of the current step.",
        "defaults": {
          "dark": "#b180d7a0",
          "light": "#652d9080",
          "highContrast": "#b180d7",
          "highContrastLight": "#652d90"
        }
      },
      {
        "id": "minuet.noteForeground",
        "description": "Color of a highlight note.",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      }
    ],
    "configuration": {
      "title": "minuet",
      "properties": {
        "minuet.suggestExecutionOrder": {
          "type": "boolean",
          "default": true,
          "description": "When a debug session ends, offer to reorder the tour if execution went through the steps in a different order."
        },
        "minuet.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show \"◆ Step N of M · title\" above each annotated line. Clicking it shows the step in Current Step."
        },
        "minuet.followCursor": {
          "type": "boolean",
          "default": true,
          "description": "When the cursor is placed on an annotated line, select that step in Tour and Current Step."
        },
        "minuet.toursFolder": {
          "type": "string",
          "default": ".minuet",
          "scope": "resource",
          "markdownDescription": "Folder where **Save Tour** writes tours and **Saved Tours** lists them. Relative to the first workspace folder, or an absolute path."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-bundle",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package-bundle": "npm run check-types && npm run lint && node esbuild.js --production",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
