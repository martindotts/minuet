{
  "name": "minuet",
  "displayName": "minuet",
  "description": "Step-by-step debugging, explained: your AI agent turns breakpoints into a guided tour of any code flow, with the real values of the run.",
  "version": "0.2.0",
  "publisher": "martindotts",
  "icon": "media/icon.png",
  "author": {
    "name": "Martin Thompson"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/martindotts/minuet.git"
  },
  "homepage": "https://github.com/martindotts/minuet#readme",
  "bugs": {
    "url": "https://github.com/martindotts/minuet/issues"
  },
  "galleryBanner": {
    "color": "#46196f",
    "theme": "dark"
  },
  "keywords": [
    "debugger",
    "breakpoints",
    "tour",
    "walkthrough",
    "javascript",
    "typescript",
    "vitest",
    "python",
    "go",
    "java",
    "ai",
    "agent",
    "claude",
    "codex",
    "copilot",
    "cursor",
    "agent-skills",
    "explain"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "minuet.addStep",
        "title": "Add Step on This Line",
        "category": "minuet",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "minuet.addHighlight",
        "title": "Highlight Selection in Step...",
        "category": "minuet",
        "icon": "$(symbol-color)"
      },
      {
        "command": "minuet.addWatch",
        "title": "Add Expression to Evaluate...",
        "category": "minuet",
        "icon": "$(eye)"
      },
      {
        "command": "minuet.editStep",
        "title": "Edit Step",
        "category": "minuet",
        "icon": "$(edit)"
      },
      {
        "command": "minuet.deleteStep",
        "title": "Delete Step",
        "category": "minuet",
        "icon": "$(trash)"
      },
      {
        "command": "minuet.moveUp",
        "title": "Move Step Up",
        "category": "minuet",
        "icon": "$(arrow-up)"
      },
      {
        "command": "minuet.moveDown",
        "title": "Move Step Down",
        "category": "minuet",
        "icon": "$(arrow-down)"
      },
      {
        "command": "minuet.newTour",
        "title": "New Tour…",
        "category": "minuet",
        "icon": "$(add)"
      },
      {
        "command": "minuet.openTour",
        "title": "Open Tour…",
        "category": "minuet",
        "icon": "$(folder-opened)"
      },
      {
        "command": "minuet.runTour",
        "title": "Run Tour",
        "category": "minuet",
        "icon": "$(play)"
      },
      {
        "command": "minuet.closeTour",
        "title": "Close Tour",
        "category": "minuet",
        "icon": "$(close)"
      },
      {
        "command": "minuet.deleteTour",
        "title": "Delete Tour…",
        "category": "minuet",
        "icon": "$(trash)"
      },
      {
        "command": "minuet.openTourFile",
        "title": "Open Tour File",
        "category": "minuet",
        "icon": "$(go-to-file)"
      },
      {
        "command": "minuet.refreshTours",
        "title": "Refresh Tours",
        "category": "minuet",
        "icon": "$(refresh)"
      },
      {
        "command": "minuet.installAgentSkill",
        "title": "Install Agent Skill",
        "category": "minuet",
        "icon": "$(sparkle)"
      },
      {
        "command": "minuet.orderByExecution",
        "title": "Order Steps by Last Run",
        "category": "minuet",
        "icon": "$(list-ordered)"
      },
      {
        "command": "minuet.openStep",
        "title": "Open Step",
        "category": "minuet"
      },
      {
        "command": "minuet.focusStep",
        "title": "Show Step",
        "category": "minuet"
      },
      {
        "command": "minuet.addVariableToStep",
        "title": "Add to Step",
        "category": "minuet"
      }
    ],
    "submenus": [
      {
        "id": "minuet.editorMenu",
        "label": "minuet"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "minuet.moveUp",
          "when": "false"
        },
        {
          "command": "minuet.moveDown",
          "when": "false"
        },
        {
          "command": "minuet.openStep",
          "when": "false"
        },
        {
          "command": "minuet.addHighlight",
          "when": "editorIsOpen"
        },
        {
          "command": "minuet.focusStep",
          "when": "false"
        },
        {
          "command": "minuet.addVariableToStep",
          "when": "false"
        },
        {
          "command": "minuet.runTour",
          "when": "minuet.hasTour"
        }
      ],
      "editor/context": [
        {
          "submenu": "minuet.editorMenu",
          "group": "minuet@1",
          "when": "resourceScheme == file"
        }
      ],
      "minuet.editorMenu": [
        {
          "command": "minuet.addStep",
          "group": "1_create@1"
        },
        {
          "command": "minuet.addHighlight",
          "group": "1_create@2",
          "when": "editorHasSelection"
        },
        {
          "command": "minuet.addWatch",
          "group": "1_create@3"
        },
        {
          "command": "minuet.editStep",
          "group": "2_edit@1"
        },
        {
          "command": "minuet.deleteStep",
          "group": "2_edit@2"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "minuet.addStep",
          "group": "minuet@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "minuet.addWatch",
          "group": "minuet@2",
          "when": "resourceScheme == file"
        },
        {
          "command": "minuet.editStep",
          "group": "minuet@3",
          "when": "resourceScheme == file"
        },
        {
          "command": "minuet.deleteStep",
          "group": "minuet@4",
          "when": "resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "minuet.openTour",
          "group": "minuet@1",
          "when": "resourceFilename =~ /(^tour|\\.tour)\\.jsonc?$/"
        }
      ],
      "view/title": [
        {
          "command": "minuet.newTour",
          "group": "navigation@1",
          "when": "view == minuet.tours"
        },
        {
          "command": "minuet.refreshTours",
          "group": "navigation@2",
          "when": "view == minuet.tours"
        },
        {
          "command": "minuet.closeTour",
          "group": "1_tour@1",
          "when": "view == minuet.tours && minuet.hasTour"
        },
        {
          "command": "minuet.openTourFile",
          "group": "1_tour@2",
          "when": "view == minuet.tours && minuet.hasTour"
        },
        {
          "command": "minuet.orderByExecution",
          "group": "2_order@1",
          "when": "view == minuet.tours && minuet.hasTour"
        },
        {
          "command": "minuet.installAgentSkill",
          "group": "y_agents@1",
          "when": "view == minuet.tours"
        },
        {
          "command": "minuet.closeTour",
          "group": "navigation@9",
          "when": "(view == minuet.currentStep || view == minuet.currentStepFallback) && minuet.hasTour"
        }
      ],
      "view/item/context": [
        {
          "command": "minuet.runTour",
          "group": "inline@0",
          "when": "view == minuet.tours && viewItem == tour.open.runnable"
        },
        {
          "command": "minuet.moveUp",
          "group": "inline@1",
          "when": "view == minuet.tours && viewItem == step"
        },
        {
          "command": "minuet.moveDown",
          "group": "inline@2",
          "when": "view == minuet.tours && viewItem == step"
        },
        {
          "command": "minuet.editStep",
          "group": "inline@3",
          "when": "view == minuet.tours && viewItem == step"
        },
        {
          "command": "minuet.deleteStep",
          "group": "inline@4",
          "when": "view == minuet.tours && viewItem == step"
        },
        {
          "command": "minuet.addWatch",
          "group": "1_edit@1",
          "when": "view == minuet.tours && viewItem == step"
        },
        {
          "command": "minuet.editStep",
          "group": "1_edit@2",
          "when": "view == minuet.tours && viewItem == step"
        },
        {
          "command": "minuet.moveUp",
          "group": "2_order@1",
          "when": "view == minuet.tours && viewItem == step"
        },
        {
          "command": "minuet.moveDown",
          "group": "2_order@2",
          "when": "view == minuet.tours && viewItem == step"
        },
        {
          "command": "minuet.deleteStep",
          "group": "3_delete@1",
          "when": "view == minuet.tours && viewItem == step"
        },
        {
          "command": "minuet.closeTour",
          "group": "inline@1",
          "when": "view == minuet.tours && viewItem =~ /^tour\\.open/"
        },
        {
          "command": "minuet.openTourFile",
          "group": "1_file@1",
          "when": "view == minuet.tours && viewItem =~ /^tour/"
        },
        {
          "command": "minuet.closeTour",
          "group": "2_tour@1",
          "when": "view == minuet.tours && viewItem =~ /^tour\\.open/"
        },
        {
          "command": "minuet.deleteTour",
          "group": "3_delete@1",
          "when": "view == minuet.tours && viewItem =~ /^tour/"
        }
      ],
      "debug/variables/context": [
        {
          "command": "minuet.addVariableToStep",
          "group": "minuet@1",
          "when": "minuet.stoppedAtStep"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "minuet",
          "title": "minuet",
          "icon": "media/tour.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "minuet-current-step",
          "title": "minuet",
          "icon": "media/tour.svg",
          "when": "!minuet.noSecondarySidebar"
        }
      ]
    },
    "views": {
      "minuet": [
        {
          "id": "minuet.tours",
          "name": "Tours",
          "icon": "media/tour.svg",
          "contextualTitle": "minuet"
        },
        {
          "type": "webview",
          "id": "minuet.currentStepFallback",
          "name": "Current Step",
          "contextualTitle": "minuet",
          "when": "minuet.noSecondarySidebar && minuet.hasCurrentStep"
        }
      ],
      "minuet-current-step": [
        {
          "type": "webview",
          "id": "minuet.currentStep",
          "name": "Current Step",
          "contextualTitle": "minuet",
          "when": "!minuet.noSecondarySidebar && minuet.hasCurrentStep"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "minuet.tours",
        "contents": "Open a folder to use tours.",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "minuet.tours",
        "contents": "No tours yet. A tour is a .tour.json file in the .minuet folder of the project: ask your agent for one, copy one there, or create it here.\n[New Tour](command:minuet.newTour)",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "colors": [
      {
        "id": "minuet.highlightBackground",
        "description": "Background of the highlighted ranges of the current step.",
        "defaults": {
          "dark": "#b180d714",
          "light": "#652d900d",
          "highContrast": "#b180d733",
          "highContrastLight": "#652d901a"
        }
      },
      {
        "id": "minuet.highlightBorder",
        "description": "Left border of the highlighted ranges of the current step.",
        "defaults": {
          "dark": "#b180d7a0",
          "light": "#652d9080",
          "highContrast": "#b180d7",
          "highContrastLight": "#652d90"
        }
      },
      {
        "id": "minuet.noteForeground",
        "description": "Color of a highlight note.",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      }
    ],
    "configuration": {
      "title": "minuet",
      "properties": {
        "minuet.suggestExecutionOrder": {
          "type": "boolean",
          "default": true,
          "description": "When a debug session ends, offer to reorder the tour if execution went through the steps in a different order."
        },
        "minuet.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show \"◆ Step N of M · title\" above the line of each step. Clicking it shows the step in Current Step."
        },
        "minuet.followCursor": {
          "type": "boolean",
          "default": true,
          "description": "When the cursor is placed on the line of a step, select that step in Tours and Current Step."
        },
        "minuet.toursFolder": {
          "type": "string",
          "default": ".minuet",
          "scope": "resource",
          "markdownDescription": "Folder of the tours (`.tour.json` files). Relative to the first workspace folder, or an absolute path."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package-bundle",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package-bundle": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "package": "vsce package --no-dependencies",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p . --outDir out",
    "test": "pnpm run compile-tests && pnpm run compile && vscode-test --label js",
    "test:python": "pnpm run compile-tests && pnpm run compile && vscode-test --label python"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@11.5.1"
}
